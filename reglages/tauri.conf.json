{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SOURISO Réglages",
  "version": "0.1.0",
  "identifier": "fr.souriso.reglages",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Réglages de SOURISO",
        "width": 880,
        "height": 600,
        "minWidth": 720,
        "minHeight": 520,
        "center": true,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
